<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PersonalLogManager.ArchitectureTests</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <ExcludeFromCodeCoverage>true</ExcludeFromCodeCoverage>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="NUnit" Version="4.3.2" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <PackageReference Include="TngTech.ArchUnitNET.NUnit" Version="0.13.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../PersonalLogManager/PersonalLogManager.csproj" />
    <None Include="../PersonalLogManager/PersonalLogManager.csproj"
          Link="ProductionProjects/PersonalLogManager.csproj"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>